# ===== build stage =====
FROM eu.gcr.io/blockchain-internal/v1/blockchain_python_3_13_build:latest AS builder

USER root

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ===== runtime stage =====
FROM eu.gcr.io/blockchain-internal/v1/blockchain_python_3_13:latest

WORKDIR /app
COPY --from=builder /install /usr/local
COPY . .

# No EXPOSE — the worker has no HTTP port. Single instance enforced by Nomad count:1.
USER blockchain
CMD ["python", "manage.py", "start_lightning_stream"]